# .env.local 로 복사해서 사용 (.env*.local 은 git에 올라가지 않음)

# 백엔드 주소. 비우면 배포 서버(https://buxby-backend.onrender.com)를 사용
# - Android 에뮬레이터에서 내 PC의 로컬 백엔드: http://10.0.2.2:8080
# - 실기기에서 내 PC의 로컬 백엔드: http://<PC의 내부 IP>:8080 (같은 Wi-Fi)
EXPO_PUBLIC_API_URL=

# 카카오 지도 JavaScript 키 (REST 키 아님)
EXPO_PUBLIC_KAKAO_JS_KEY=

# 개발 중 true면 로그인 버튼이 백엔드 확인 없이 다음 화면으로 이동
EXPO_PUBLIC_SKIP_LOGIN=false
